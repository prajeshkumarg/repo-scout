# Copy to .env and adjust. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://scout:scout@localhost:5432/repo_scout

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=127.0.0.1
API_PORT=8000

# Where the web app reaches the API from the Next.js server
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
